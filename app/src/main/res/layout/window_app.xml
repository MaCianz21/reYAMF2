<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:elevation="8dp"
    android:background="@null"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:theme="@style/Theme.Material3.DayNight">

    <View
        android:id="@+id/rootClickMask"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvParent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@null"
        android:backgroundTint="@android:color/transparent"
        android:elevation="8dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="15dp"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:cardBackgroundColor="?attr/colorSurface"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:strokeColor="@color/transparentOutline"
        app:strokeWidth="0dp">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvapp_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="2dp"
            android:layout_marginVertical="2dp"
            android:visibility="invisible"
            app:cardBackgroundColor="?attr/colorSurface">

            <ImageView
                android:id="@+id/app_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/collapsed_app_icon"
                tools:srcCompat="@tools:sample/avatars" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cvBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="2dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:visibility="invisible"
            android:clipChildren="false"
            android:clipToPadding="false"
            app:cardBackgroundColor="?attr/colorSurface"
            app:strokeWidth="0dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorSurface"
                android:clipChildren="false"
                android:clipToPadding="false">

                <SurfaceView
                    android:id="@+id/viewSurface"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cvNotch" />

                <TextureView
                    android:id="@+id/viewTexture"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cvNotch" />

                <RelativeLayout
                    android:id="@+id/v_sizePreviewer"
                    android:layout_width="200dp"
                    android:layout_height="300dp"
                    android:background="@drawable/a_bg"
                    android:elevation="5dp"
                    android:visibility="invisible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/cvNotch" />

                <!-- Transparent strip above the app content: it holds the three dots as a
                     padding band instead of painting a notch over the app. -->
                <FrameLayout
                    android:id="@+id/cvNotch"
                    android:layout_width="84dp"
                    android:layout_height="26dp"
                    android:background="@null"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageButton
                        android:id="@+id/ibSuper"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:contentDescription="@string/window_actions_desc"
                        android:scaleType="center"
                        android:src="@drawable/three_dot_horiz"
                        android:tint="?attr/colorOnSurfaceVariant" />
                </FrameLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.card.MaterialCardView>

    <ImageButton
        android:id="@+id/ibResizeLeft"
        android:layout_width="12dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/resize_desc"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/cvParent"
        app:layout_constraintStart_toStartOf="@+id/cvParent"
        app:layout_constraintTop_toTopOf="@+id/cvParent" />

    <ImageButton
        android:id="@+id/ibRightResize"
        android:layout_width="12dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/resize_desc"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/cvParent"
        app:layout_constraintEnd_toEndOf="@+id/cvParent"
        app:layout_constraintTop_toTopOf="@+id/cvParent" />

    <ImageButton
        android:id="@+id/ibResizeBottom"
        android:layout_width="0dp"
        android:layout_height="15dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/resize_desc"
        android:elevation="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/cvParent"
        app:layout_constraintEnd_toEndOf="@+id/cvParent"
        app:layout_constraintStart_toStartOf="@+id/cvParent" />
    <ImageButton
        android:id="@+id/ibResizeBottomLeft"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/resize_desc"
        android:elevation="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/cvParent"
        app:layout_constraintStart_toStartOf="@+id/cvParent" />

    <ImageButton
        android:id="@+id/ibResizeBottomRight"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/resize_desc"
        android:elevation="11dp"
        app:layout_constraintBottom_toBottomOf="@+id/cvParent"
        app:layout_constraintEnd_toEndOf="@+id/cvParent" />

</androidx.constraintlayout.widget.ConstraintLayout>